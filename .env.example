# Environment Mode
NODE_ENV=development
PORT=5000
DEMO_MODE=true

# Supabase Credentials (Free Tier)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Upstash Redis (Free Tier)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# MongoDB Atlas (Free Tier)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/quickbites?retryWrites=true&w=majority

# Meilisearch Cloud (Free Tier)
MEILISEARCH_HOST=https://your-search.meilisearch.io
MEILISEARCH_API_KEY=your-meilisearch-key

# Cloudflare R2 Bucket (Zero Egress)
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=quickbites-assets
R2_PUBLIC_URL=https://assets.quickbite.app

# Razorpay Sandbox (Free Simulated Payments)
RAZORPAY_KEY_ID=rzp_test_samplekey123
RAZORPAY_KEY_SECRET=sample_secret_key_456
RAZORPAY_WEBHOOK_SECRET=sample_webhook_secret_789


# Firebase Cloud Messaging
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json

# Platform bootstrap - the single admin created at boot. Production refuses
# to start without these rather than running with no way in.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password

# Demo restaurants and menus: true locally and in tests, false in production.
SEED_DEMO_DATA=true

# Phone sign-in. OTP_PROVIDER is fixed | msg91 | twilio.
# The fixed driver delivers nothing and accepts one known code; production
# refuses it unless OTP_ALLOW_FIXED_IN_PRODUCTION is set deliberately, and
# removing that variable IS the switch to real OTP.
# India: TRAI DLT entity, header and template approval are required by law
# before any provider will deliver. See legal/COMPLIANCE.md.
OTP_PROVIDER=fixed
OTP_FIXED_CODE=123456
OTP_ALLOW_FIXED_IN_PRODUCTION=false
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# --- Google Maps -----------------------------------------------------------
# TWO DIFFERENT KEYS, protected in two different ways. Mixing them up is the
# expensive mistake here, so the difference is spelled out.
#
# SERVER key: address autocomplete, reverse geocoding, and road distances, all
# proxied through this backend so the key never reaches a phone. It CANNOT be
# restricted by app, only by IP, so it is genuinely secret: set it on the
# deployment (Railway) and nowhere else. Never put it in an APK — the
# check-apk-secrets scan fails any build whose JS bundle contains a key of this
# shape, for exactly this reason.
# Needs enabled: Places API, Geocoding API, Distance Matrix API.
GOOGLE_MAPS_SERVER_KEY=

# ANDROID key: drawing the map inside the apps. Baked into each APK at build
# time by the withGoogleMapsApiKey config plugin, because the native Maps SDK
# reads it from the manifest as the process starts — there is no runtime way to
# supply it. It is extractable from any APK by design; what protects it is the
# package name + release SHA-1 restriction set on it in the Cloud console, NOT
# secrecy. Set it in your local .env to build with real maps. Absent, the apps
# fall back to the drawn map and nothing crashes.
# Needs enabled: Maps SDK for Android.
GOOGLE_MAPS_ANDROID_KEY=

# Biases address search to one country, so "MG Road" returns Bengaluru.
PLACES_REGION=in

# How much longer a road is than the straight line under it. Used for the
# restaurant list, where a paid road measurement per restaurant per home-screen
# visit is not worth it, and for any pair Google could not route. 1.3 is the
# measured figure for dense Indian street grids; tune it by comparing these
# estimates against the road distances Google returns on real orders.
ROAD_DISTANCE_FACTOR=1.3

# The delivery radius assumed for a restaurant that has not set its own.
# A restaurant is listed to a customer only if that customer is inside it.
DEFAULT_SERVICE_RADIUS_KM=8
