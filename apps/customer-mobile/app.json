{
  "expo": {
    "name": "Quick Bites",
    "slug": "quick-bite",
    "version": "1.4.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "quickbite",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.quickbites.app",
      "buildNumber": "10",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "Quick Bites",
        "LSApplicationQueriesSchemes": [
          "tel",
          "mailto",
          "whatsapp",
          "tez",
          "phonepe",
          "paytmmp",
          "credpay",
          "mobikwik",
          "bhim",
          "amazonpay",
          "navi",
          "kiwi",
          "payzapp",
          "jupiter",
          "sbiyono",
          "myjio",
          "slice-upi",
          "in.fampay.app"
        ]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeEmailAddress",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeName",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePhoneNumber",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePhysicalAddress",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePurchaseHistory",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePreciseLocation",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePhotosorVideos",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeCustomerSupport",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherUserContent",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeDeviceID",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ],
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": []
      },
      "userInterfaceStyle": "light"
    },
    "android": {
      "package": "in.quickbites.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 32,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ]
    },
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Quick Bites uses your location while you use the app to show nearby restaurants, set your delivery address on the map and show how far your food is.",
          "locationAlwaysAndWhenInUsePermission": "Quick Bites uses your location only while you use the app, to show nearby restaurants and set your delivery address on the map. It does not track you in the background.",
          "locationAlwaysPermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E23744"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Quick Bites uses your photos only when you choose a picture for your profile.",
          "cameraPermission": "Quick Bites uses the camera only when you take a picture for your profile.",
          "microphonePermission": "Quick Bites uses the microphone only while you are speaking a search."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Quick Bites uses the microphone only while you are speaking a search.",
          "speechRecognitionPermission": "Quick Bites uses speech recognition to turn what you say into a search."
        }
      ],
      "../../packages/config/expo-plugins/withReleaseSigning",
      "../../packages/config/expo-plugins/withArmOnlyAbis",
      "../../packages/config/expo-plugins/withLocalDevCleartext",
      "../../packages/config/expo-plugins/withLegacyBackGesture",
      "../../packages/config/expo-plugins/withExternalAppQueries",
      "../../packages/config/expo-plugins/withFmtCxx17",
      "../../packages/config/expo-plugins/withRazorpayXcode26",
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./assets/fonts/LexendDeca_400Regular.ttf",
              "./assets/fonts/LexendDeca_500Medium.ttf",
              "./assets/fonts/LexendDeca_600SemiBold.ttf",
              "./assets/fonts/LexendDeca_700Bold.ttf",
              "./assets/fonts/LexendDeca_800ExtraBold.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "LexendDeca",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/LexendDeca_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/LexendDeca_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/LexendDeca_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/LexendDeca_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/LexendDeca_800ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              }
            ]
          }
        }
      ]
    ]
  }
}
