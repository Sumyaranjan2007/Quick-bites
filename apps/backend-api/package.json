{
  "name": "@quick-bites/backend-api",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test:health": "node --experimental-strip-types src/test/health.test.ts",
    "test:db": "node --experimental-strip-types src/test/db.test.ts",
    "test:orders": "node --experimental-strip-types src/test/orders.test.ts",
    "test:search": "node --experimental-strip-types src/test/search.test.ts",
    "test:sockets": "node --experimental-strip-types src/test/sockets.test.ts",
    "test": "node --experimental-strip-types src/test/health.test.ts && node --experimental-strip-types src/test/db.test.ts && node --experimental-strip-types src/test/orders.test.ts && node --experimental-strip-types src/test/search.test.ts && node --experimental-strip-types src/test/sockets.test.ts",
    "db:seed": "node --experimental-strip-types src/db/seed.ts",
    "search:sync": "node --experimental-strip-types src/scripts/syncSearch.ts"
  },
  "dependencies": {
    "@quick-bites/pricing-engine": "*",
    "@quick-bites/shared-types": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^7.1.0",
    "socket.io": "^4.8.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.5",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
