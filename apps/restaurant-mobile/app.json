{
  "expo": {
    "name": "Quick Bites Partner",
    "slug": "quick-bite-partner",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "quickbitepartner",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.quickbite.partner"
    },
    "android": {
      "package": "com.quickbite.partner",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "newArchEnabled": false,
    "icon": "./assets/icon.png"
  }
}
