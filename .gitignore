node_modules/
dist/
.turbo/
.cache/
.expo/
.env
.env.local
*.log
.DS_Store
coverage/
scratch/
# Generated native projects — recreated by `expo prebuild`, never hand-edited.
# Signing and SDK settings live in app.json + the withReleaseSigning plugin so
# they survive regeneration.
apps/*/android/
apps/*/ios/

# Android upload signing — keystores and passwords must never be committed
**/keystore.properties
*.jks
*.keystore
!**/debug.keystore
*.password
