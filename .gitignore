node_modules/
dist/
.turbo/
.cache/
.expo/
.env
.env.local
*.log
.DS_Store
coverage/
scratch/
# Generated native projects — recreated by `expo prebuild`, never hand-edited.
# Signing and SDK settings live in app.json + the withReleaseSigning plugin so
# they survive regeneration.
apps/*/android/
apps/*/ios/

# Android upload signing — keystores and passwords must never be committed
**/keystore.properties
*.jks
*.keystore
!**/debug.keystore
*.password

# Runtime database snapshot — regenerated from the seed on first boot.
# Committing it made deploys serve stale data and reset live orders.
apps/backend-api/data/store.json

# Release binaries — 55 MB each, four of them. GitHub warns above 50 MB and a
# clone should not carry 220 MB of artefacts that are already published as
# Release assets. DOWNLOAD.md links to the release, not to these paths.
build/apk/
# Launch-test screenshots: evidence for one run on one emulator, regenerated
# every time. Megabytes of PNG that go stale the moment anything changes.
build/screenshots/

# Firebase client config. Ships inside the APK, so it is not a secret in the
# strict sense - but this repository is public and keys do not belong in it.
# Recreate from the Firebase console: Project settings > your Android apps.
apps/*/google-services.json
