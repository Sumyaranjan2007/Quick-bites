{
  "name": "quick-bites-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "diagnostics": "node scripts/diagnostics.js"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.6.2",
    "prettier": "^3.3.3",
    "eslint": "^9.10.0"
  },
  "packageManager": "npm@10.8.2"
}