{
  "name": "quick-bites-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "diagnostics": "node scripts/diagnostics.js",
    "check:secrets": "node scripts/check-secrets.mjs",
    "verify": "node scripts/check-secrets.mjs && node scripts/diagnostics.js && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.6.2",
    "prettier": "^3.3.3",
    "eslint": "^9.10.0"
  },
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=22.6.0"
  },
  "overrides": {
    "react-native-svg": "15.8.0"
  },
  "dependencies": {
    "react-native-svg": "15.8.0"
  }
}
